# ============================================================
# Django
# ============================================================
# Сгенерируйте командой:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-generate-a-new-one
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Какое settings-модуль использовать:
#   config.settings.dev  — для локальной разработки
#   config.settings.prod — для продакшена
DJANGO_SETTINGS_MODULE=config.settings.dev

# ============================================================
# Database (PostgreSQL 18)
# ============================================================
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Полный URL (используется в settings для парсинга)
DATABASE_URL=postgres://portfolio:portfolio@db:5432/portfolio

# ============================================================
# Email
# ============================================================
# dev:  django.core.mail.backends.console.EmailBackend  — письма в консоль
# prod: django.core.mail.backends.smtp.EmailBackend     — реальная отправка
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com
ADMIN_EMAIL=admin@example.com